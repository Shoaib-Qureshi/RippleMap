{
  "name": "ripplemap",
  "displayName": "RippleMap",
  "description": "See what your AI agent changed and how your app's workflow graph changes, in real time.",
  "version": "0.1.0",
  "publisher": "ShoaibQureshi",
  "author": {
    "name": "Shoaib Qureshi"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shoaib-Qureshi/RippleMap.git"
  },
  "homepage": "https://github.com/Shoaib-Qureshi/RippleMap#readme",
  "bugs": {
    "url": "https://github.com/Shoaib-Qureshi/RippleMap/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14213d",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "claude code",
    "cursor",
    "mcp",
    "ai agent",
    "call graph",
    "dependency graph",
    "code review",
    "diff",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ripplemap.openPanel",
        "title": "Open Panel",
        "category": "RippleMap",
        "icon": "$(graph)"
      },
      {
        "command": "ripplemap.openInBrowser",
        "title": "Open Graph in Browser",
        "category": "RippleMap",
        "icon": "$(globe)"
      },
      {
        "command": "ripplemap.openInNewWindow",
        "title": "Open Graph in New Window",
        "category": "RippleMap",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "ripplemap.clearHistory",
        "title": "Clear Edit History",
        "category": "RippleMap",
        "icon": "$(clear-all)"
      },
      {
        "command": "ripplemap.reindex",
        "title": "Re-index Workspace",
        "category": "RippleMap",
        "icon": "$(refresh)"
      },
      {
        "command": "ripplemap.installHooks",
        "title": "Install Claude Code Hooks",
        "category": "RippleMap"
      },
      {
        "command": "ripplemap.removeHooks",
        "title": "Remove Claude Code Hooks",
        "category": "RippleMap"
      },
      {
        "command": "ripplemap.installCursorHooks",
        "title": "Install Cursor Hooks (MCP activity)",
        "category": "RippleMap"
      },
      {
        "command": "ripplemap.removeCursorHooks",
        "title": "Remove Cursor Hooks",
        "category": "RippleMap"
      },
      {
        "command": "ripplemap.setAiKey",
        "title": "Set AI API Key",
        "category": "RippleMap"
      },
      {
        "command": "ripplemap.showEditDiff",
        "title": "Show Edit Diff",
        "category": "RippleMap"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ripplemap",
          "title": "RippleMap",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ripplemap": [
        {
          "id": "ripplemap.editFeed",
          "name": "Edit Feed"
        },
        {
          "id": "ripplemap.activity",
          "name": "Agent Activity"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ripplemap.editFeed",
        "contents": "No edits yet. Save a file or let your AI agent edit one.\n[Install Claude Code Hooks](command:ripplemap.installHooks)\n[Open Graph Panel](command:ripplemap.openPanel)"
      },
      {
        "view": "ripplemap.activity",
        "contents": "Nothing yet. When Claude Code calls an MCP server, fetches or searches the web, or runs a network command (curl, git push, npm install\u2026), it shows up here.\n[Install Claude Code Hooks](command:ripplemap.installHooks)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ripplemap.openPanel",
          "when": "view == ripplemap.editFeed",
          "group": "navigation"
        },
        {
          "command": "ripplemap.openInBrowser",
          "when": "view == ripplemap.editFeed",
          "group": "navigation"
        },
        {
          "command": "ripplemap.openInNewWindow",
          "when": "view == ripplemap.editFeed",
          "group": "navigation"
        },
        {
          "command": "ripplemap.clearHistory",
          "when": "view == ripplemap.editFeed",
          "group": "navigation"
        },
        {
          "command": "ripplemap.clearHistory",
          "when": "view == ripplemap.activity",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ripplemap.showEditDiff",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "RippleMap",
      "properties": {
        "ripplemap.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "vendor",
            "dist",
            "build",
            "out",
            ".git",
            ".next",
            ".vscode-test",
            "coverage",
            "__pycache__",
            ".venv",
            "venv",
            "wp-includes",
            "wp-admin",
            ".claude"
          ],
          "description": "Folder names ignored for edit tracking and graph indexing."
        },
        "ripplemap.decorationFadeSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "How long edited-line highlights take to fade out."
        },
        "ripplemap.indexOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Index the workspace graph when VS Code starts."
        },
        "ripplemap.maxNodes": {
          "type": "number",
          "default": 1500,
          "minimum": 50,
          "description": "Maximum nodes rendered at once; the most connected are kept."
        },
        "ripplemap.snapshotLimit": {
          "type": "number",
          "default": 50,
          "minimum": 2,
          "description": "How many graph snapshots to keep for the diff and time scrubber."
        },
        "ripplemap.ai.baseUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "scope": "application",
          "markdownDescription": "OpenAI-compatible API used by **Explain with AI** (OpenRouter by default; e.g. `https://generativelanguage.googleapis.com/v1beta/openai` for Gemini, `http://localhost:11434/v1` for Ollama). Only contacted when you click the button. Application-scoped so a workspace can't redirect your key."
        },
        "ripplemap.ai.model": {
          "type": "string",
          "default": "openrouter/free",
          "markdownDescription": "Model for **Explain with AI**. `openrouter/free` picks an available free OpenRouter model; any model id works (e.g. `google/gemma-4-31b-it:free`)."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist out",
    "build": "run-s clean build:ext build:webview",
    "build:ext": "node esbuild.config.mjs",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch": "run-p watch:*",
    "watch:ext": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "npm run build && node test/integration/runTests.mjs",
    "package": "npm run build && vsce package --no-dependencies --no-rewrite-relative-links -o ripplemap.vsix",
    "test:vsix": "npm run package && node test/integration/runTests.mjs --vsix ripplemap.vsix"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@vscode/vsce": "^4.1.0",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "preview": true,
  "pricing": "Free"
}
