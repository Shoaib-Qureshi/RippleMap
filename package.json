{
  "name": "flowlens",
  "displayName": "FlowLens",
  "description": "See what your AI agent changed and how your app's workflow graph changes, in real time.",
  "version": "0.0.1",
  "publisher": "tier2",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flowlens.openPanel",
        "title": "Open Panel",
        "category": "FlowLens",
        "icon": "$(graph)"
      },
      {
        "command": "flowlens.clearHistory",
        "title": "Clear Edit History",
        "category": "FlowLens",
        "icon": "$(clear-all)"
      },
      {
        "command": "flowlens.installHooks",
        "title": "Install Claude Code Hooks",
        "category": "FlowLens"
      },
      {
        "command": "flowlens.removeHooks",
        "title": "Remove Claude Code Hooks",
        "category": "FlowLens"
      },
      {
        "command": "flowlens.showEditDiff",
        "title": "Show Edit Diff",
        "category": "FlowLens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowlens",
          "title": "FlowLens",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "flowlens": [
        {
          "id": "flowlens.editFeed",
          "name": "Edit Feed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "flowlens.editFeed",
        "contents": "No edits yet. Save a file or let your AI agent edit one.\n[Install Claude Code Hooks](command:flowlens.installHooks)\n[Open Graph Panel](command:flowlens.openPanel)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flowlens.openPanel",
          "when": "view == flowlens.editFeed",
          "group": "navigation"
        },
        {
          "command": "flowlens.clearHistory",
          "when": "view == flowlens.editFeed",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "flowlens.showEditDiff",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "FlowLens",
      "properties": {
        "flowlens.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "vendor",
            "dist",
            "build",
            "out",
            ".git",
            ".next",
            ".vscode-test",
            "coverage",
            "__pycache__",
            ".venv",
            "venv",
            "wp-includes",
            "wp-admin"
          ],
          "description": "Folder names ignored for edit tracking and graph indexing."
        },
        "flowlens.decorationFadeSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "How long edited-line highlights take to fade out."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist out",
    "build": "run-s clean build:ext build:webview",
    "build:ext": "node esbuild.config.mjs",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch": "run-p watch:*",
    "watch:ext": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "npm run build && node test/integration/runTests.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-electron": "^3.1.0",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "html-to-image": "^1.11.13",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "diff": "^9.0.0"
  }
}
